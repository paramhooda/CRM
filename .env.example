# Copy to .env as is for a local run; nothing needs editing. Never commit .env.

# Postgres connection: `docker compose up -d db` creates database `crm` with user `crm` and this password
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm"

# Password of the Postgres user, used by docker-compose.yml only. Change it (here and in DATABASE_URL) before
# exposing the database beyond your machine.
POSTGRES_PASSWORD=crm

# Port the app listens on (docker-compose.yml)
APP_PORT=3000

# Seed demo data on first start when the database is empty and show one-click demo logins on the sign-in page
# (demo only; never in production)
SEED_DEMO_DATA=false

# Set to "true" when the app is served over HTTPS so the session cookie is marked Secure
COOKIE_SECURE=false

# Optional assistant: "Draft with AI" in the hand-over dialogs and a one-click deal brief. Leave blank to keep it
# off. When set, deal text (names, lines, notes; prices for sales roles) is sent to OpenAI.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
