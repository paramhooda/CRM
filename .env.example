# Copy to .env and fill in. Never commit .env.

# Postgres connection (the compose file creates database `crm` with user `crm`)
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm"

# Password of the Postgres user, used by docker-compose.yml only
POSTGRES_PASSWORD=crm

# Port the app listens on (docker-compose.yml)
APP_PORT=3000

# Seed demo data on first start when the database is empty (demo only; never in production)
SEED_DEMO_DATA=false

# Set to "true" when the app is served over HTTPS so the session cookie is marked Secure
COOKIE_SECURE=false
