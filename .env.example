# Progression CRM settings. Copy to .env and fill in. See docs/operations.md.

# ── Docker Compose install ──
# Database password (required). Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=""
# Port the CRM listens on. 80 to serve http://<server>/ directly; 127.0.0.1:3000 when using the HTTPS proxy below.
APP_PORT=3000

# Optional HTTPS on your own domain: point the domain's DNS at this server, then set these three and run
#   docker compose --profile https up -d
# DOMAIN=crm.yourcompany.com
# APP_PORT=127.0.0.1:3000
# TRUST_PROXY=true

# Optional: the address people open the CRM at, for links in emails (otherwise set in Admin → Email & system)
# APP_URL=https://crm.yourcompany.com

# Session signing key. Leave empty with Docker Compose: one is generated and kept in the appdata volume.
# For local development: openssl rand -base64 48
SESSION_SECRET=""
# auto (default): secure cookies whenever the CRM is opened over HTTPS. true / false to force.
COOKIE_SECURE=auto

# Test installs only: load demo data into an empty database, and show one-click demo sign-in
SEED_DEMO_DATA=false
DEMO_LOGINS=false

# Nightly backup time (24h, server time zone Asia/Kolkata) and days to keep
BACKUP_TIME=01:30
BACKUP_KEEP_DAYS=14

# ── Local development only (npm run dev) ──
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"
